---
import type { Publication } from '../data/publications';
import { formatDate, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
interface Props { pub: Publication; lang: Lang }
const { pub, lang } = Astro.props;
const t = useTranslations(lang);
---
<li class="card">
  <div class="meta">
    <time datetime={pub.date}>{formatDate(pub.date, lang)}</time>
    <span>{pub.mins} {t('blog.readingTime')}</span>
  </div>
  <h3><a href={pub.url[lang]} target="_blank" rel="noopener noreferrer">{pub.title[lang]}</a></h3>
  <p>{pub.teaser[lang]}</p>
  <a class="cta" href={pub.url[lang]} target="_blank" rel="noopener noreferrer">{t('pubs.read')} <span aria-hidden="true">↗</span></a>
</li>
