---
---
<p class="visitor-ip wrap mono" hidden data-visitor-ip>
  <span>Your IP: <b class="visitor-ip-value" data-visitor-ip-value></b></span>
  <span class="visitor-ip-note dim">Shown only to you. Not stored by this site. Looked up via a public echo service.</span>
</p>

<script>
  const root = document.querySelector<HTMLElement>('[data-visitor-ip]');
  const valueEl = document.querySelector<HTMLElement>('[data-visitor-ip-value]');

  const isIp = (value: string) => {
    if (!value || value.length > 45) return false;
    const v4 = /^(?:\d{1,3}\.){3}\d{1,3}$/;
    if (v4.test(value)) return value.split('.').every((octet) => Number(octet) <= 255);
    if (!value.includes(':') || /[^0-9A-Fa-f:.]/.test(value)) return false;
    return (value.match(/::/g) ?? []).length <= 1;
  };

  if (root && valueEl) {
    const ctrl = new AbortController();
    const timer = window.setTimeout(() => ctrl.abort(), 5000);
    fetch('https://api64.ipify.org?format=json', {
      signal: ctrl.signal,
      credentials: 'omit',
      cache: 'no-store',
    })
      .then((response) => (response.ok ? response.json() : Promise.reject()))
      .then((data: { ip?: unknown }) => {
        const ip = typeof data?.ip === 'string' ? data.ip.trim() : '';
        if (!isIp(ip)) return;
        valueEl.textContent = ip;
        root.hidden = false;
      })
      .catch(() => {})
      .finally(() => window.clearTimeout(timer));
  }
</script>
