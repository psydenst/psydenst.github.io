---
---
<span class="nv-visitor" hidden data-visitor-ip>
  <span class="nv-seg nv-visitor-line">
    <span class="nv-visitor-ip-row">IP:<b class="nv-visitor-ip" data-visitor-ip-value></b></span>
    <span class="nv-visitor-sep" aria-hidden="true">•</span>
    <span class="nv-visitor-city" data-visitor-ip-city></span>
  </span>
</span>

<script>
  const root = document.querySelector<HTMLElement>('[data-visitor-ip]');
  const lineEl = document.querySelector<HTMLElement>('.nv-visitor-line');
  const ipEl = document.querySelector<HTMLElement>('[data-visitor-ip-value]');
  const cityEl = document.querySelector<HTMLElement>('[data-visitor-ip-city]');

  const isIp = (value: string) => {
    if (!value || value.length > 45) return false;
    const v4 = /^(?:\d{1,3}\.){3}\d{1,3}$/;
    if (v4.test(value)) return value.split('.').every((octet) => Number(octet) <= 255);
    if (!value.includes(':') || /[^0-9A-Fa-f:.]/.test(value)) return false;
    return (value.match(/::/g) ?? []).length <= 1;
  };

  const cityName = (value: unknown) => {
    if (typeof value !== 'string') return '';
    const city = value.trim().replace(/[\u0000-\u001F\u007F]/g, '');
    return city.length > 0 && city.length <= 80 ? city : '';
  };

  const shortenIp = (ip: string) => {
    if (!ip.includes(':')) return ip;
    const parts = ip.split(':');
    if (ip.length <= 22 || parts.length < 5) return ip;
    return `${parts.slice(0, 3).join(':')}…:${parts.slice(-2).join(':')}`;
  };

  type Geo = { ip: string; city: string };
  type Endpoint = { url: string; pick: (data: Record<string, unknown>) => Geo | null };

  const endpoints: Endpoint[] = [
    {
      url: 'https://get.geojs.io/v1/ip/geo.json',
      pick: (data) => (typeof data.ip === 'string' ? { ip: data.ip.trim(), city: cityName(data.city) } : null),
    },
    {
      url: 'https://ipwho.is/',
      pick: (data) => {
        if (data.success === false || typeof data.ip !== 'string') return null;
        return { ip: data.ip.trim(), city: cityName(data.city) };
      },
    },
    {
      url: 'https://api64.ipify.org?format=json',
      pick: (data) => (typeof data.ip === 'string' ? { ip: data.ip.trim(), city: '' } : null),
    },
  ];

  const lookup = async (): Promise<Geo | null> => {
    for (const endpoint of endpoints) {
      const ctrl = new AbortController();
      const timer = window.setTimeout(() => ctrl.abort(), 4000);
      try {
        const response = await fetch(endpoint.url, { signal: ctrl.signal, credentials: 'omit' });
        if (!response.ok) continue;
        const picked = endpoint.pick((await response.json()) as Record<string, unknown>);
        if (picked && isIp(picked.ip)) return picked;
      } catch {
        // try the next public echo service
      } finally {
        window.clearTimeout(timer);
      }
    }
    return null;
  };

  if (root && lineEl && ipEl && cityEl) {
    lookup().then((geo) => {
      if (!geo) return;
      ipEl.textContent = shortenIp(geo.ip);
      cityEl.textContent = geo.city || 'Unknown';
      lineEl.title = geo.ip;
      root.hidden = false;
      document.querySelectorAll<HTMLElement>('.nv-encoding').forEach((el) => {
        el.hidden = true;
      });
    });
  }
</script>
