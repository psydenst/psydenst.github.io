---
import { sections } from '../data/site';
import { localizePath, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
interface Props { current?: string; lang: Lang }
const { current, lang } = Astro.props;
const t = useTranslations(lang);
---
<ul class="chips" aria-label={t('blog.sections.aria')}>
  <li><a href={localizePath('/blog', lang)} aria-current={!current ? 'page' : undefined}>{t('blog.all')}</a></li>
  {sections.map((s) => (
    <li><a href={localizePath(`/blog/${s.slug}`, lang)} aria-current={current === s.slug ? 'page' : undefined}>{s.label[lang]}</a></li>
  ))}
</ul>
