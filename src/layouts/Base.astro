---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import '../styles/layout.css';
import '../styles/nvim.css';
import LangSwitch from '../components/LangSwitch.astro';
import VisitorIp from '../components/VisitorIp.astro';
import { site } from '../data/site';
import { defaultTheme, themes } from '../data/themes';
import { getLangFromUrl, localizePath, stripLang, useTranslations, localeTag } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, description = t('site.description'), image } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : t('site.title');

const route = stripLang(Astro.url.pathname);
const nav = [
  { href: '/', label: t('nav.home') },
  { href: '/about', label: t('nav.about') },
  { href: '/blog', label: t('nav.blog') },
];
const themeColors = Object.fromEntries(themes.map((th) => [th.name, th.color]));
const homeTheme = themes.find((th) => th.name === defaultTheme)!;
const isCurrent = (href: string) => (href === '/' ? route === '/' : route === href || route.startsWith(href + '/'));

const origin = Astro.site ?? Astro.url;
const abs = (p: string) => new URL(p, origin).href;
const ogImage = abs(image ?? '/og.png');
---
<!doctype html>
<html lang={localeTag(lang)} data-theme={defaultTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content={themeColors[defaultTheme]} />
    <script is:inline define:vars={{ themeColors }}>
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'light') localStorage.setItem('theme', (saved = 'peachpuff'));
        if (saved && themeColors[saved]) {
          document.documentElement.dataset.theme = saved;
          document.querySelector('meta[name="theme-color"]').setAttribute('content', themeColors[saved]);
        }
      } catch (e) {}
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={abs(localizePath(route, lang))} />
    <link rel="alternate" hreflang="en" href={abs(localizePath(route, 'en'))} />
    <link rel="alternate" hreflang="pt-BR" href={abs(localizePath(route, 'pt'))} />
    <link rel="alternate" hreflang="x-default" href={abs(localizePath(route, 'en'))} />
    <meta property="og:type" content={image ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('a11y.skip')}</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={localizePath('/', lang)}>psydenst<span>.</span></a>
        <nav class="nav" id="site-nav" aria-label={t('nav.main')}>
          <ul>
            {nav.map((n) => (
              <li>
                <a href={localizePath(n.href, lang)} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
              </li>
            ))}
            <li><a href={site.linkedin} target="_blank" rel="noopener noreferrer">{t('nav.linkedin')} <span aria-hidden="true">↗</span></a></li>
          </ul>
        </nav>
        <div class="header-tools">
          <LangSwitch lang={lang} route={route} />
          <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label={t('nav.menu')}>
            <span></span><span></span>
          </button>
          <div class="orrery" data-orrery>
            <button type="button" class="orb-trigger" aria-expanded="false" aria-controls="orb-panel" data-label={t('theme.label')} aria-label={`${t('theme.label')}: ${defaultTheme}`} title={t('theme.label')}>
              <span class="orb-mini" aria-hidden="true"><span class="orb-mini-planet"></span></span>
            </button>
            <div class="orb-panel" id="orb-panel">
              <div class="orb-system" role="radiogroup" aria-label={t('theme.label')}>
                <span class="orb-sun" aria-hidden="true"></span>
                {themes.map((th, i) => (
                  <div class={`orb-orbit ${th.planet}`} style={`--i: ${i}`}>
                    <div class="orb-track">
                      <button
                        type="button"
                        role="radio"
                        class={`orb-planet ${th.planet}`}
                        data-theme-choice={th.name}
                        data-planet={th.label[lang]}
                        data-color={th.color}
                        aria-checked={th.name === defaultTheme ? 'true' : 'false'}
                        aria-label={`${th.name} (${th.label[lang]})`}
                        tabindex={th.name === defaultTheme ? 0 : -1}
                      >
                        <span class="orb-body" aria-hidden="true"></span>
                      </button>
                    </div>
                  </div>
                ))}
              </div>
              <p class="orb-caption mono" aria-hidden="true">
                <span data-orb-planet>{homeTheme.label[lang]}</span><span class="dim">·</span><b data-orb-name>{homeTheme.name}</b>
              </p>
            </div>
          </div>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="footer-brand mono"><span class="dim">--</span> psydenst<span class="dot">.</span> <span class="dim">· {new Date().getFullYear()} --</span></p>
        <ul class="mono">
          <li><a href={site.github} rel="noopener noreferrer">{t('footer.github')}</a></li>
          <li><a href={site.linkedin} target="_blank" rel="noopener noreferrer">{t('nav.linkedin')}</a></li>
          <li><a href={site.nymAuthor[lang]} target="_blank" rel="noopener noreferrer">{t('footer.nym')}</a></li>
        </ul>
      </div>
      <VisitorIp />
    </footer>
    <script>
      const btn = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const nav = document.getElementById('site-nav');
      btn?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open') ?? false;
        btn.setAttribute('aria-expanded', String(open));
        document.body.classList.toggle('nav-open', open);
      });
      const header = document.querySelector<HTMLElement>('.site-header');
      if (header) {
        let lastY = window.scrollY;
        const onScroll = () => {
          const y = window.scrollY;
          if (y <= 8) {
            header.classList.remove('hidden', 'scrolled');
            lastY = y;
            return;
          }
          if (Math.abs(y - lastY) < 6) return;
          if (y > lastY && !nav?.classList.contains('open') && !header.querySelector('.orrery.open')) {
            header.classList.add('hidden');
          } else {
            header.classList.remove('hidden');
            header.classList.add('scrolled');
          }
          lastY = y;
        };
        if (window.scrollY > 8) header.classList.add('scrolled');
        addEventListener('scroll', onScroll, { passive: true });
      }
      const root = document.documentElement;
      const orrery = document.querySelector<HTMLElement>('[data-orrery]');
      const trigger = orrery?.querySelector<HTMLButtonElement>('.orb-trigger');
      if (orrery && trigger) {
        const planets = [...orrery.querySelectorAll<HTMLButtonElement>('[data-theme-choice]')];
        const home = planets.find((p) => p.getAttribute('aria-checked') === 'true') ?? planets[0];
        const captionPlanet = orrery.querySelector<HTMLElement>('[data-orb-planet]');
        const captionName = orrery.querySelector<HTMLElement>('[data-orb-name]');
        const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
        let current = home;

        const caption = (p: HTMLButtonElement) => {
          if (captionPlanet) captionPlanet.textContent = p.dataset.planet ?? '';
          if (captionName) captionName.textContent = p.dataset.themeChoice ?? '';
        };
        const applyTheme = (name: string) => {
          current = planets.find((p) => p.dataset.themeChoice === name) ?? home;
          root.dataset.theme = current.dataset.themeChoice;
          planets.forEach((p) => {
            p.setAttribute('aria-checked', String(p === current));
            p.tabIndex = p === current ? 0 : -1;
          });
          themeColor?.setAttribute('content', current.dataset.color ?? '');
          trigger.setAttribute('aria-label', `${trigger.dataset.label}: ${current.dataset.themeChoice}`);
          caption(current);
        };
        const choose = (p: HTMLButtonElement) => {
          root.classList.add('theming');
          applyTheme(p.dataset.themeChoice ?? '');
          try { localStorage.setItem('theme', current.dataset.themeChoice ?? ''); } catch {}
          setTimeout(() => root.classList.remove('theming'), 400);
        };
        const setOpen = (open: boolean, focusPlanet = false) => {
          orrery.classList.toggle('open', open);
          trigger.setAttribute('aria-expanded', String(open));
          if (open && focusPlanet) current.focus();
        };
        applyTheme(root.dataset.theme ?? home.dataset.themeChoice ?? '');

        // a click with detail 0 came from the keyboard: move focus into the orrery
        trigger.addEventListener('click', (e) => setOpen(!orrery.classList.contains('open'), e.detail === 0));
        planets.forEach((p, i) => {
          p.addEventListener('click', () => choose(p));
          p.addEventListener('mouseenter', () => caption(p));
          p.addEventListener('mouseleave', () => caption(current));
          p.addEventListener('focus', () => caption(p));
          p.addEventListener('keydown', (e) => {
            const last = planets.length - 1;
            const moves: Record<string, number> = { ArrowRight: i + 1, ArrowDown: i + 1, ArrowLeft: i - 1, ArrowUp: i - 1, Home: 0, End: last };
            const next = moves[e.key];
            if (next === undefined) return;
            e.preventDefault();
            const target = planets[(next + planets.length) % planets.length];
            target.focus();
            choose(target);
          });
        });
        orrery.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape' || !orrery.classList.contains('open')) return;
          setOpen(false);
          trigger.focus();
        });
        orrery.addEventListener('focusout', (e) => {
          const to = e.relatedTarget as Node | null;
          if (to && !orrery.contains(to)) setOpen(false);
          caption(current);
        });
        document.addEventListener('pointerdown', (e) => {
          if (orrery.classList.contains('open') && !orrery.contains(e.target as Node)) setOpen(false);
        });
      }
      document.querySelectorAll<HTMLAnchorElement>('.lang-switch a').forEach((a) => {
        a.addEventListener('click', () => {
          try { localStorage.setItem('lang', a.dataset.lang ?? 'en'); } catch {}
        });
      });
    </script>
  </body>
</html>
