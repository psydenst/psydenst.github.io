---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { formatDate, sectionLabel } from '../../../data/site';
import { getPosts, postSlug } from '../../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { section: post.data.section, slug: postSlug(post.id) }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <article class="wrap">
    <header class="page-head">
      <p class="eyebrow"><a href={`/blog/${post.data.section}`}>{sectionLabel(post.data.section)}</a></p>
      <h1>{post.data.title}</h1>
      <div class="meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>{post.data.tags.map((t) => <span class="badge">{t}</span>)}</div>
      <hr class="rule" style="margin-top:1.25rem" />
    </header>
    <div class="prose"><Content /></div>
  </article>
</Base>
