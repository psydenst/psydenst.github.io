---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="About" description="About psydenst: software developer, DevOps engineer, and digital-privacy activist.">
  <div class="wrap">
    <header class="page-head"><p class="eyebrow">About</p><h1>psydenst</h1><hr class="rule" /></header>
    <div class="prose">
      <p>I am a software developer and DevOps engineer, and a digital-privacy activist. I write for the Nym community and co-founded the TupiNymQuim squad.</p>
      <h2>Roles</h2>
      <ul>
        <li>Software developer and DevOps engineer</li>
        <li>Digital-privacy activist</li>
        <li>Nym community writer</li>
        <li>Co-founder of the TupiNymQuim squad</li>
      </ul>
      <h2>Topics</h2>
      <ul>
        <li>42 RNCP 7</li>
        <li>Cybersecurity</li>
        <li>DevOps</li>
        <li>Privacy tests</li>
        <li>Technology and society</li>
      </ul>
      <p>Code lives on <a href={site.github}>GitHub</a>; published pieces are on my <a href={site.nymAuthor} target="_blank" rel="noopener noreferrer">Nym author page</a>.</p>
    </div>
  </div>
</Base>
