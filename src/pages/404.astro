---
import Base from '../layouts/Base.astro';
import NvimBar from '../components/NvimBar.astro';
import { ui } from '../i18n/ui';
---
<Base title={ui.en['notfound.title']}>
  <div class="wrap nv-page">
    <header class="page-head">
      <p class="eyebrow mono">E404</p>
      <h1>{ui.en['notfound.title']} <span class="muted">/ {ui.pt['notfound.title']}</span></h1>
      <hr class="rule" />
      <p><a href="/">{ui.en['notfound.back']}</a> · <a href="/pt/">{ui.pt['notfound.back']}</a></p>
    </header>
    <NvimBar kind="status" path="~/404" />
  </div>
</Base>
