---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import PublicationCard from '../components/PublicationCard.astro';
import { publications } from '../data/publications';
import { getPosts } from '../lib';
const latest = (await getPosts()).slice(0, 5);
---
<Base>
  <section class="hero">
    <div class="hero-art" aria-hidden="true"></div>
    <div class="wrap hero-copy">
      <p class="eyebrow">Portfolio · Blog</p>
      <h1>psydenst</h1>
      <p>Software developer and DevOps engineer, digital-privacy activist, Nym community writer, and co-founder of the TupiNymQuim squad. I write about 42 RNCP 7, cybersecurity, DevOps, privacy tests, and technology and society.</p>
    </div>
  </section>
  <div class="wrap cols">
    <section>
      <h2>Latest posts</h2><hr class="rule" />
      {latest.length === 0 ? <p class="empty">No texts yet. <a href="/blog">See the blog sections</a>.</p> : <PostList posts={latest} />}
    </section>
    <section>
      <h2>On Nym</h2><hr class="rule purple" />
      <ul class="card-grid" style="grid-template-columns:1fr">
        {publications.slice(0, 3).map((pub) => <PublicationCard pub={pub} />)}
      </ul>
      <p><a href="/publications">All publications →</a></p>
    </section>
  </div>
</Base>
