---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import NvimBar from '../components/NvimBar.astro';
import { sectionLabel } from '../data/site';
import { formatDate, getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';
import { postSlug, readingStats, tagPath, type Post } from '../lib';
interface Props { post: Post }
const { post } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { Content, headings } = await render(post);
const { words, minutes } = readingStats(post);
const file = `~/blog/${post.data.section}/${postSlug(post.id)}.md`;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const source = post.data.source ? new URL(post.data.source) : null;
const sourceName = post.data.sourceName ?? source?.hostname.replace(/^www\./, '');
const untranslated = post.data.lang !== lang;
---
<Base title={post.data.title} description={post.data.description} image={post.data.cover}>
  <div class="wrap nv-page nv-post">
    <NvimBar kind="tab" path={file} />
    <article lang={post.data.lang === 'pt' ? 'pt-BR' : 'en'}>
      <header class="post-head">
        <p class="eyebrow mono">
          <a href={localizePath(`/blog/${post.data.section}`, lang)}>{sectionLabel(post.data.section, lang)}</a>
          <span class="dim"> / </span><span class="dim">{postSlug(post.id)}.md</span>
        </p>
        <h1 class="nv-title">{post.data.title}<span class="cursor" aria-hidden="true"></span></h1>
        <p class="lede muted">{post.data.description}</p>
        <div class="meta mono">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
          <span>{minutes} {t('blog.readingTime')}</span>
          <span>{words} {t('blog.words')}</span>
          {untranslated && <span class={`badge ${post.data.lang}`}>{post.data.lang}</span>}
        </div>
        {post.data.tags.length > 0 && (
          <ul class="tags mono" aria-label="Tags">{post.data.tags.map((tag) => <li><a href={localizePath(tagPath(tag), lang)}>#{tag}</a></li>)}</ul>
        )}
        {untranslated && <p class="notice mono">{t('blog.untranslated')}</p>}
      </header>

      {post.data.cover && (
        <figure class="post-cover">
          <img src={post.data.cover} alt="" width="1280" height="720" loading="eager" decoding="async" />
        </figure>
      )}

      <div class="post-grid">
        <aside class="post-side">
          {source && (
            <div class="side-note mono">
              <p class="dim">-- {t('post.source').toLowerCase()} --</p>
              <p class="side-source"><a href={source.href} target="_blank" rel="noopener noreferrer">{sourceName} <span aria-hidden="true">↗</span></a></p>
              <p class="muted">{t('post.sourceNote')}</p>
            </div>
          )}
          {toc.length > 1 && (
            <nav class="toc mono" aria-label={t('blog.outline')}>
              <p class="dim">-- {t('blog.outline')} --</p>
              <ol>
                {toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
              </ol>
            </nav>
          )}
        </aside>
        <div class="prose nv-prose" id="post-body"><Content /></div>
      </div>

      {source && (
        <footer class="post-foot mono">
          <span class="dim">--</span> {t('post.source')} <a href={source.href} target="_blank" rel="noopener noreferrer">{sourceName}</a> · <a href={source.href} target="_blank" rel="noopener noreferrer">{t('post.readOriginal')} ↗</a> <span class="dim">--</span>
        </footer>
      )}
    </article>
    <NvimBar kind="status" path={file} lang={lang} scroll />
  </div>
</Base>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const heads = links
    .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
    .filter((h): h is HTMLElement => h !== null);
  const side = document.querySelector<HTMLElement>('.post-side');
  let current: HTMLAnchorElement | undefined;

  const activate = (link: HTMLAnchorElement | undefined) => {
    if (!link || link === current) return;
    current?.classList.remove('active');
    current?.removeAttribute('aria-current');
    link.classList.add('active');
    link.setAttribute('aria-current', 'location');
    current = link;
    if (side && side.scrollHeight > side.clientHeight) {
      const top = link.offsetTop - side.clientHeight / 2;
      side.scrollTo({ top, behavior: 'smooth' });
    }
  };

  const update = () => {
    if (!heads.length) return;
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
    const line = window.innerHeight * 0.3;
    let i = atBottom ? heads.length - 1 : 0;
    if (!atBottom) heads.forEach((h, n) => { if (h.getBoundingClientRect().top <= line) i = n; });
    activate(links[i]);
  };

  links.forEach((a) => a.addEventListener('click', () => activate(a)));
  addEventListener('scroll', update, { passive: true });
  addEventListener('resize', update);
  update();
</script>
