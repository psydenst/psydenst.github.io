---
import Base from '../layouts/Base.astro';
import { portfolio } from '../data/portfolio';
import { site } from '../data/site';
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<Base title={t('portfolio.title')} description={t('portfolio.description')}>
  <div class="wrap">
    <header class="page-head"><p class="eyebrow">{t('portfolio.title')}</p><h1>{t('portfolio.heading')}</h1><hr class="rule cyan" /></header>
    {portfolio.length === 0 ? (
      <p class="empty">
        {t('portfolio.empty.before')}<a href={site.github}>{t('portfolio.empty.github')}</a>{t('portfolio.empty.middle')}<a href={localizePath('/publications', lang)}>{t('portfolio.empty.pubs')}</a>{t('portfolio.empty.after')}
      </p>
    ) : (
      <ul class="card-grid">
        {portfolio.map((item) => (
          <li class="card">
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
            {item.url && <a class="cta" href={item.url} target="_blank" rel="noopener noreferrer">{t('portfolio.open')} <span aria-hidden="true">↗</span></a>}
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>
