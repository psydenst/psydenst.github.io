---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import NvimBar from '../components/NvimBar.astro';
import { topicBlurb, topicLabel } from '../data/site';
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';
import { getPosts, getTopics, tagPath } from '../lib';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const posts = await getPosts(lang);
const latest = posts.slice(0, 6);
const topics = await getTopics(lang);
---
<Base>
  <section class="hero">
    <div class="hero-art" aria-hidden="true"></div>
    <div class="wrap hero-copy">
      <p class="eyebrow mono">{t('home.eyebrow')}</p>
      <h1 class="nv-title">psydenst<span class="dot">.</span><span class="cursor" aria-hidden="true"></span></h1>
      <p class="lede">{t('home.lede')}</p>
      <div class="actions">
        <a class="btn primary" href={localizePath('/blog', lang)}>{t('home.cta.blog')}</a>
        <a class="btn" href={localizePath('/about', lang)}>{t('home.cta.about')}</a>
      </div>
    </div>
  </section>

  <div class="wrap nv-page home-body">
    <NvimBar kind="tab" path="~/" />
    <section>
      <h2 class="mono-h">{t('home.latest')}</h2>
      {latest.length === 0 ? (
        <p class="empty">{t('home.latest.empty')} <a href={localizePath('/blog', lang)}>{t('home.latest.link')}</a>.</p>
      ) : (
        <PostList posts={latest} lang={lang} />
      )}
      <p class="more mono"><a href={localizePath('/blog', lang)}>{t('home.allPosts')} →</a></p>
    </section>
    <section>
      <h2 class="mono-h">{t('home.topics')}</h2>
      <ul class="section-grid">
        {topics.map(({ tag, count }) => (
          <li>
            <a href={localizePath(tagPath(tag), lang)}>
              <span class="mono dim"><span class="hash">#</span>{tag} <span class="count">{count}</span></span>
              <strong>{topicLabel(tag, lang)}</strong>
              {topicBlurb(tag, lang) && <span class="muted">{topicBlurb(tag, lang)}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
    <NvimBar kind="status" path="~/" right={`${posts.length} ${posts.length === 1 ? 'buf' : 'bufs'}`} lang={lang} />
  </div>
</Base>
