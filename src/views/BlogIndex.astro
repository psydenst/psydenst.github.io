---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import BlogFilters from '../components/BlogFilters.astro';
import NvimBar from '../components/NvimBar.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { getPosts } from '../lib';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const posts = await getPosts(lang);
---
<Base title={t('blog.title')} description={t('blog.description')}>
  <div class="wrap nv-page">
    <NvimBar kind="tab" path="~/blog/" />
    <header class="page-head">
      <p class="eyebrow mono">:ls</p>
      <h1 class="nv-title">{t('blog.title')}<span class="cursor" aria-hidden="true"></span></h1>
      <p class="muted">{t('blog.description')}</p>
    </header>
    <BlogFilters lang={lang} />
    <PostList posts={posts} lang={lang} />
    <NvimBar kind="status" path="~/blog/" right={`${posts.length} ${posts.length === 1 ? 'buf' : 'bufs'}`} lang={lang} />
  </div>
</Base>
